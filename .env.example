# Plantilla de variables de entorno — El Quetzal · Equipo Virtual Insanity
# Copiar este archivo como .env y llenar las contraseñas reales.
# El .env NUNCA se sube al repo (está en .gitignore). Este archivo sí.

# ---------- Identificadores del equipo ----------
EQUIPO=virtual4insanity
HOSTNAME_VM=srv-elquetzal-virtualinsanity
DOCKERHUB_NAMESPACE=virtual4insanity

# ---------- Postgres (motor) ----------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_clave

# ---------- Catálogo ----------
CATALOGO_DB=db_catalogo
CATALOGO_DB_USER=usr_catalogo
CATALOGO_DB_PASSWORD=cambiar_esta_clave

# ---------- Inventario ----------
INVENTARIO_DB=db_inventario
INVENTARIO_DB_USER=usr_inventario
INVENTARIO_DB_PASSWORD=cambiar_esta_clave

# ---------- Clientes ----------
CLIENTES_DB=db_clientes
CLIENTES_DB_USER=usr_clientes
CLIENTES_DB_PASSWORD=cambiar_esta_clave

# ---------- Pedidos ----------
PEDIDOS_DB=db_pedidos
PEDIDOS_DB_USER=usr_pedidos
PEDIDOS_DB_PASSWORD=cambiar_esta_clave

# ---------- Reportes ----------
REPORTES_DB=db_reportes
REPORTES_DB_USER=usr_reportes
REPORTES_DB_PASSWORD=cambiar_esta_clave

# ---------- Gateway ----------
GATEWAY_PUERTO_HOST=8080

# ---------- Aplicación ----------
UMBRAL_STOCK_BAJO=10
FLASK_ENV=production
